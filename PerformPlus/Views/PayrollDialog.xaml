<Window x:Class="PerformPlus.Views.PayrollDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource EditPayrollTitle}"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignDarkPaper}">

    <!-- İsteğe bağlı: implicit stil ayarları -->
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#444444"/>
            <Setter Property="materialDesign:HintAssist.Foreground" Value="White"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20" Width="400">
        <!-- Read‑only employee info -->
        <TextBlock Text="{Binding EmployeeID, StringFormat='ID: {0}'}"
                   Margin="0,0,0,10"/>
        <TextBlock Text="{Binding GrossSalary, StringFormat='Gross: {0:C}'}"
                   Margin="0,0,0,20"/>

        <!-- Editable fields -->
        <TextBox Margin="0,0,0,10"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 materialDesign:HintAssist.Hint="{DynamicResource OvertimeRateHint}"
                 Text="{Binding OvertimeHours, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="{Binding OvertimePay, StringFormat='Overtime Pay: {0:C}'}"
                   Margin="0,0,0,20"/>

        <TextBox Margin="0,0,0,10"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 materialDesign:HintAssist.Hint="{DynamicResource MealAllowanceHint}"
                 Text="{Binding MealAllowance, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="{Binding TravelAllowance, StringFormat='Travel Allowance: {0:C}'}"
                   Margin="0,0,0,20"/>

        <TextBox Margin="0,0,0,20"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 materialDesign:HintAssist.Hint="{DynamicResource DefaultBonusHint}"
                 Text="{Binding Bonus, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="{Binding NetSalary, StringFormat='Net: {0:C}'}"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Save / Cancel -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="{DynamicResource SaveButton}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="Save_Click"
                    Width="80"
                    Margin="0,0,10,0"/>
            <Button Content="{DynamicResource CancelButton}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Click="Cancel_Click"
                    Width="80"/>
        </StackPanel>
    </StackPanel>
</Window>
