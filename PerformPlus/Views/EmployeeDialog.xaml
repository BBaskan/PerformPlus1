<Window x:Class="PerformPlus.Views.EmployeeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Employee Dialog"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignDarkPaper}">
    <StackPanel Margin="30" Width="400" Background="#333333">
        <TextBox Margin="0,10"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 materialDesign:HintAssist.Hint="{DynamicResource FullNameHint}"
                 Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                 Foreground="White"
                 Background="#444444"/>

        <TextBox Margin="0,10"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 materialDesign:HintAssist.Hint="{DynamicResource UsernameHint}"
                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                 Foreground="White"
                 Background="#444444"/>

        <!-- For Password, you can use a TextBox for demonstration purposes -->
        <TextBox Margin="0,10"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 materialDesign:HintAssist.Hint="{DynamicResource PasswordHint}"
                 Text="{Binding PasswordHash, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                 Foreground="White"
                 Background="#444444"/>

        <TextBox Margin="0,10"
         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
         materialDesign:HintAssist.Hint="{DynamicResource BaseSalaryHint}"
         Text="{Binding BaseSalary, UpdateSourceTrigger=PropertyChanged}"
         Foreground="White" Background="#444444"/>


        <ComboBox Margin="0,10"
                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                  materialDesign:HintAssist.Hint="{DynamicResource RoleHint}"
                  SelectedValue="{Binding Role, UpdateSourceTrigger=PropertyChanged}"
                  SelectedValuePath="Tag"
                  Foreground="White"
                  Background="#444444">
            <ComboBoxItem Content="{DynamicResource AdminText}" Tag="Admin"/>
            <ComboBoxItem Content="{DynamicResource LeaderText}" Tag="Leader"/>
            <ComboBoxItem Content="{DynamicResource UserText}" Tag="User"/>
        </ComboBox>

        <TextBox Margin="0,10"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 materialDesign:HintAssist.Hint="{DynamicResource TeamIDHint}"
                 Text="{Binding TeamID, UpdateSourceTrigger=PropertyChanged}"
                 Foreground="White"
                 Background="#444444"/>

        <TextBox Margin="0,10"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 materialDesign:HintAssist.Hint="{DynamicResource EmailHint}"
                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                 Foreground="White"
                 Background="#444444"/>


        <ComboBox Margin="0,10"
          Style="{StaticResource MaterialDesignFloatingHintComboBox}"
          materialDesign:HintAssist.Hint="{DynamicResource MaritalStatusHint}"
          SelectedValue="{Binding MaritalStatus, UpdateSourceTrigger=PropertyChanged}"
          SelectedValuePath="Tag"
          Foreground="White"
          Background="#444444">
            <ComboBoxItem Content="{DynamicResource MarriedText}" Tag="Married"/>
            <ComboBoxItem Content="{DynamicResource SingleText}" Tag="Single"/>
        </ComboBox>

        <TextBox Margin="0,10"
         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
         materialDesign:HintAssist.Hint="{DynamicResource ChildrenHint}"
         Text="{Binding NumberOfChildren, UpdateSourceTrigger=PropertyChanged}"
         Foreground="White"
         Background="#444444"/>


        <!-- DatePicker for HireDate -->
        
        
        <DatePicker Margin="0,10"
                    SelectedDate="{Binding HireDate, UpdateSourceTrigger=PropertyChanged}"
                    Foreground="White"
                    Background="#444444"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{DynamicResource SaveButton}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="0,0,10,0"
                    Width="80"
                    Click="Save_Click"/>
            <Button Content="{DynamicResource CancelButton}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Width="80"
                    Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>