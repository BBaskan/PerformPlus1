<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:md="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="PerformPlus.Views.TaskAssignmentDialog"
        Title="{DynamicResource AssignTaskTitle}"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        Foreground="White">

    <Window.Resources>
        <!-- Light Green -->

        <!-- Apply dark green themed style -->
        <SolidColorBrush x:Key="AccentColorBrush" Color="#00C853"/>

        <!-- Floating Hint TextBox Style Override -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="#00C853"/>
            <Setter Property="md:HintAssist.Foreground" Value="#00C853"/>
        </Style>

        <Style TargetType="{x:Type DatePicker}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="#00C853"/>
            <Setter Property="md:HintAssist.Foreground" Value="#00C853"/>
        </Style>

        <Style TargetType="{x:Type Label}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20" Width="400" >
        <!-- Title -->
        <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 md:HintAssist.Hint="{DynamicResource TitleHint}"
                 Text="{Binding Assignment.Title, Mode=TwoWay}"
                 Margin="0,0,0,10"/>

        <!-- Description -->
        <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 md:HintAssist.Hint="{DynamicResource DescriptionHint}"
                 Text="{Binding Assignment.Description, Mode=TwoWay}"
                 Margin="0,0,0,10"/>

        <!-- Due Date -->
        <DatePicker SelectedDate="{Binding Assignment.DueDate, Mode=TwoWay}"
                    md:HintAssist.Hint="{DynamicResource DueDateHint}"
                    Margin="0,0,0,10"/>

        <!-- Multi-select Users -->
        <Label Content="{DynamicResource SelectUsersLabel}" Margin="0,0,0,4"/>
        <DataGrid ItemsSource="{Binding Employees}"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          HeadersVisibility="Column"
          Background="#2A2A2A"
          Foreground="White"
          BorderBrush="#00C853"
          BorderThickness="1"
          Height="200"
          Margin="0,0,0,20"
          RowHeaderWidth="0"
          SelectionMode="Extended"
          SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="✓"
                                Binding="{Binding IsSelected, Mode=TwoWay}" 
                                Width="40"/>
                <DataGridTextColumn Header="{DynamicResource FullNameLabel}"
                            Binding="{Binding FullName}" 
                            Width="*"/>
                <DataGridTextColumn Header="{DynamicResource TeamLabel}"
                            Binding="{Binding TeamID}" 
                            Width="*"/>
            </DataGrid.Columns>
        </DataGrid>


        <!-- Save / Cancel -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{DynamicResource SaveButton}"
              Command="{Binding SaveCommand}"
              IsDefault="True"
              Style="{StaticResource MaterialDesignRaisedButton}"
              Margin="0,0,10,0"/>
            <Button Content="{DynamicResource CancelButton}"
              Command="{Binding CancelCommand}"
              IsCancel="True"
              Style="{StaticResource MaterialDesignFlatButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
