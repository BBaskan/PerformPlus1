<Window x:Class="PerformPlus.Views.PayrollSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource PayrollSettingsTitle}"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignDarkPaper}">

   
    <StackPanel Margin="30" Width="300">
        <TextBox Margin="0,0,0,10"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 materialDesign:HintAssist.Hint="{DynamicResource MealAllowanceHint}"
                 Text="{Binding MealAllowance, UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Margin="0,0,0,10"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 materialDesign:HintAssist.Hint="{DynamicResource TravelAllowanceHint}"
                 Text="{Binding TravelAllowance, UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Margin="0,0,0,10"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 materialDesign:HintAssist.Hint="{DynamicResource DefaultBonusHint}"
                 Text="{Binding DefaultBonus, UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Margin="0,0,0,10"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 materialDesign:HintAssist.Hint="{DynamicResource OvertimeRateHint}"
                 Text="{Binding OvertimeHourlyRate, UpdateSourceTrigger=PropertyChanged}" />

     
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="{DynamicResource SaveButton}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding SaveCommand}"
                    Click="Save_Click"
                    Width="80"
                    Margin="0,0,10,0"/>
            <Button Content="{DynamicResource CancelButton}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{Binding CancelCommand}"
                    Click="Cancel_Click"
                    Width="80"/>
        </StackPanel>
    </StackPanel>
</Window>
