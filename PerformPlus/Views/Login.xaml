<Window x:Class="PerformPlus.Views.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="PerformPlus Login" Height="400" Width="500"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignDarkPaper}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

       
        <TextBlock  Text="{DynamicResource LoginTitle}"
                   FontSize="28" FontWeight="Bold" 
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="White"
                   Grid.ColumnSpan="2"
                   Grid.Row="0"/>

        <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0">
            <Button Content="EN"
                        Click="BtnEnglish_Click"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="White"
                        Margin="5,0"/>
            <Button Content="TR"
                        Click="BtnTurkish_Click"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="White"
                        Margin="5,0"/>
        </StackPanel>

       
        <StackPanel Grid.Column="0" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <TextBlock Text="{Binding CurrentDate, StringFormat='{}{0:dd.MM.yyyy}'}"
                       FontSize="18" Foreground="White" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding CurrentTime, StringFormat='{}{0:HH:mm:ss}'}"
                       FontSize="32" FontWeight="Bold" Foreground="White"/>
        </StackPanel>

        
        <materialDesign:Card Grid.Column="1" Grid.Row="1" Margin="30" Padding="20" 
                     Background="#333333"
                     materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel HorizontalAlignment="Right" Width="400">
                
                <TextBox x:Name="txtUsername"
                         Margin="0,10"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         materialDesign:HintAssist.Hint="{DynamicResource UsernameHint}"
                         Foreground="White"
                         Background="#444444"/>

               
                <Grid>
                   
                    <PasswordBox x:Name="pwdBox"
                                 Margin="0,10"
                                 Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                materialDesign:HintAssist.Hint="{DynamicResource PasswordHint}"
                                 Foreground="White"
                                 Background="#444444"/>
                    <!-- TextBox to show password when needed -->
                    <TextBox x:Name="txtPassword"
                             Margin="0,10"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             materialDesign:HintAssist.Hint="{DynamicResource PasswordHint}"
                             Foreground="White"
                             Background="#444444"
                             Visibility="Collapsed"/>
                </Grid>

                
                <CheckBox x:Name="chkShowPassword" Content="{DynamicResource ShowPassword}"  
                          Foreground="White" Margin="0,0,0,10"
                          Checked="chkShowPassword_Checked" 
                          Unchecked="chkShowPassword_Unchecked"/>

              
                <Button x:Name="btnLogin" Content="{DynamicResource LoginButton}" 
                        Margin="0,20"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="LoginButton_Click"/>
            </StackPanel>
        </materialDesign:Card>

       
        <TextBlock Text="{DynamicResource FooterText}" 
                   FontSize="12" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   Foreground="LightGray"
                   Grid.ColumnSpan="2"
                   Grid.Row="2"/>
    </Grid>
</Window>

    